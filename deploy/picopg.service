[Unit]
Description=Pico main service
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/picopg
EnvironmentFile=%h/.config/picopg/server.env
ExecStart=/usr/bin/python3 %h/picopg/apps/server/main.py --host 127.0.0.1 --port 8001 --data %h/picopg/data --principal-config %h/picopg/config/principals.json --submission-repositories %h/picopg/config/submissions.json
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/picopg/data
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
